<body>
    <!-- Sidenav -->
    <%- include('../partials/sidebar') -%>
    <!-- Main content -->
    <div class="main-content">
      <!-- Top navbar -->
      <%- include('../partials/navbar') -%>
      <!-- Header -->
      <%- include('../partials/header') -%>
      <!-- Page content -->
      <div class="container-fluid mt--7">
        <!-- Table -->
        <div class="row">
          <div class="col">
            <div class="card shadow">
              <div class="card-header border-0">
                <h3 class="mb-0">User Management</h3>
              </div>
              <div class="table-responsive px-3">
                <table class="table align-items-center table-flush" id="datatable">
                  <thead class="thead-light">
                    <tr>
                      <th scope="col">No</th>
                      <th scope="col">Main Photo</th>
                      <th scope="col">Name</th>
                      <th scope="col">Email</th>
                      <th scope="col">Gender</th>
                      <th scope="col">Birthday</th>
                      <th scope="col">Active</th>
                      <th scope="col">Role</th>
                      <th scope="col">Login state</th>
                      <th scope="col">Created Date</th>
                      <th scope="col"></th>
                      <th scope="col"></th>
                      <!-- <th scope="col"></th> -->
                    </tr>
                  </thead>
                  <tbody id="mytbody">
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div id="myModal" class="modal">
          <div class="del-modal-content">
            <span class="close">&times;</span>
            <h2>Remove User</h2>
            <p>Are you sure you want to delete this user?</p>
            <div style="display: flex;justify-content: right;">
              <input type="hidden" id="del_id" value="">
              <button class="btn bg-info text-white" onclick="del()">Ok</button>&nbsp;&nbsp;&nbsp;<button class="btn bg-light" onclick="cancel()">Cancel</button>
            </div>
          </div>
        </div>
        <div id="editModal" class="modal">
          <div class="edit-modal-content">
            <span class="editClose">&times;</span>
            <h2>Edit User</h2>
            <div class="card">
              <div class="card-body row">
                  <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                      <div class="row">
                          <div class="col-md-3 row" style="justify-content: center; align-content: center;">
                              <div class="col-md-8 row">
                                <img id="user-avatar" src="" alt="..." style="max-width: 100%;max-height: 100%;">
                              </div>
                          </div>
                          <div class="col-md-9 row">
                              <label class="col-md-2 col-form-label">Name</label>
                              <div class="col-md-4">
                                  <div class="form-group bmd-form-group is-filled">
                                      <input class="form-control" id="user-fullname" type="text" placeholder="Name" value="" readonly>
                                  </div>
                              </div>
                              <label class="col-sm-2 col-form-label">Email</label>
                              <div class="col-sm-4">
                                  <div class="form-group bmd-form-group">
                                      <input class="form-control" id="user-email" type="email" placeholder="Email" value="" readonly>
                                  </div>
                              </div>
                              <label class="col-sm-2 col-form-label">Birthday</label>
                              <div class="col-sm-4">
                                  <div class="form-group bmd-form-group is-filled">
                                      <input class="form-control" id="user-birth" type="text" placeholder="" value="" readonly>
                                  </div>
                              </div>
                              <label class="col-sm-2 col-form-label">Gender</label>
                              <div class="col-sm-4">
                                <div class="form-group bmd-form-group is-filled">
                                    <input class="form-control" id="user-gender" type="text" placeholder="" value="" readonly>
                                </div>
                              </div>
                              <label class="col-sm-2 col-form-label">Login State</label>
                              <div class="col-sm-4">
                                  <div class="form-group bmd-form-group">
                                      <input class="form-control" id="user-login_status" type="text" placeholder="Login State" value="" readonly>
                                  </div>
                              </div>
                              <label class="col-sm-2 col-form-label">Created Date</label>
                              <div class="col-sm-4">
                                  <div class="form-group bmd-form-group">
                                      <input class="form-control" id="user-date" type="text" placeholder="Created Date" value="" readonly>
                                  </div>
                              </div>
                          </div>
                      </div>
                  </div>
              </div>
              <div class="card-footer" style="display: flex;">
                  <div class="form-check" style="margin-right:60px;">
                    <label class="form-check-label">
                      <input class="form-check-input" id="user-status" type="checkbox" value="">
                      Allow this user.
                      <span class="form-check-sign">
                          <span class="check"></span>
                      </span>
                    </label>
                  </div>
                  <div class="form-check" style="margin-right:60px;">
                    <label class="form-check-label">
                      <input class="form-check-input" id="user-role" type="checkbox" value="">
                      Admin
                      <span class="form-check-sign">
                          <span class="check"></span>
                      </span>
                    </label>
                </div>
              </div>
            </div>
            <div style="display: flex;justify-content: right;">
              <input type="hidden" id="edit_id" value="">
              <button class="btn bg-primary text-white" onclick="edit()">Save</button>&nbsp;&nbsp;&nbsp;<button class="btn bg-light" onclick="editCancel()">Cancel</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  
    <!-- Include scripts -->
    <%- include('../partials/scripts') -%>
    <script>
      var datatable = $('#datatable').DataTable({
        "pageLength": 10,
        "lengthMenu": [10, 25, 50, 100],
        "ordering": true,
        "columnDefs": [
          { "orderable": false, "targets": [] }
        ]
      });
      const reloadData = () => {
        $.ajax({
          url:'/admin/getUserData',
          type: "POST",
          data: {ok:true},
          dataType: 'json',
          beforeSend: function(){
          },
          success:function(res){
            if(res.success){
              var data = JSON.parse(res.data);
              var html = '';
              $.each(data, function( index, item ) {
                html += '<tr>';
                html += '<td>'+(index+1)+'</td>';
                if(item.avatar){
                  html += '<td><img src="../uploads/images/'+item.avatar+'" style="max-width: 75px;max-height: 75px;border-radius: 20%;"></td>';
                }else{
                  html += '<td></td>';
                }
                html += '<td>'+item.fullname+'</td>';
                html += '<td>'+item.email+'</td>';
                if(item.gender){
                  if(item.gender=="0"){
                    html += '<td>Male</td>';
                  }else{
                    html += '<td>Female</td>';
                  }
                }else{
                  html += '<td></td>';
                }
                if(item.birth){
                  html += '<td>'+item.birth+'</td>';
                }else{
                  html += '<td></td>';
                }
  
                html += '<td><span class="badge badge-dot mr-4" id="checkView'+item._id+'">';
                if(item.status){
                  html += '<i class="bg-success"></i> A';
                }else{
                  html += '<i class="bg-warning"></i> D';
                }
                html += '</span></td>';
  
                if(item.role){
                  html += '<td>Admin</td>';
                }else{
                  html += '<td>User</td>';
                }
  
                if(item.login_status){
                  html += '<td>On</td>';
                }else{
                  html += '<td>Off</td>';
                }
                html += '<td>'+new Date(item.date).toLocaleDateString('en-US', {month: 'short',day: 'numeric',year: 'numeric'})+'</td>';
                html += '<td>'+'<span onclick="editModal(\''+item._id+'\')" style="font-size:1rem;cursor:pointer"><i class="fa fa-pen fa-sm text-green"></i></span>'+'</td>';
                html += '<td>'+'<span onclick="showModal(\''+item._id+'\')" style="font-size:1.5rem;cursor:pointer"><i class="ni ni-fat-remove text-red"></i></span>'+'</td>';
                html += '</tr>';
              });
              datatable.clear();
              datatable.rows.add($(html)).draw();
            }
          }
        })
      }
  
      function msgChecked(id){
        let isChecked = $('#check'+id).prop('checked')?1:0;
        var addHtml = '';
        $.ajax({
          url:'/admin/activeUser',
          type: "POST",
          data: {id:id, status:isChecked},
          dataType: 'json',
          beforeSend: function(){
          },
          success:function(res){
            if(res.success){
              if(isChecked){
                addHtml += '<i class="bg-success"></i> A';
              }else{
                addHtml += '<i class="bg-warning"></i> D';
              }
              $('#checkView'+id).html(addHtml);
            }
          }
        })
      }
      function showModal(id){
        var modal = document.getElementById('myModal');
        modal.style.display = 'block';
        $('#del_id').val(id);
      }
      function del(){
        let del_id = $('#del_id').val();
        if(del_id != ''){
          $.ajax({
            url:'/admin/delUser',
            type: "POST",
            data: {id:del_id},
            dataType: 'json',
            beforeSend: function(){
            },
            success:function(res){
              if(res.success){
                $('#del_id').val('');
                var modal = document.getElementById('myModal');
                modal.style.display = 'none';
                reloadData();
              }
            }
          })
        }
      }
      function cancel(){
        var modal = document.getElementById('myModal');
        $('#del_id').val('');
        modal.style.display = 'none';
      }
      function editModal(id){
        var modal = document.getElementById('editModal');
        modal.style.display = 'block';
        //format modal
        $('#user-avatar').attr('src', '...');
        $('#user-fullname').val('');
        $('#user-email').val('');
        $('#user-gender').val('');
        $('#user-birth').val('');
        $('#user-status').prop('checked', false);
        $('#user-role').prop('checked', false);
        $('#user-login_status').val('');
        $('#user-date').val('');
        $('#edit_id').val('');
        $.ajax({
          url:'/admin/getOneUser',
          type: "POST",
          data: {id:id},
          dataType: 'json',
          beforeSend: function(){
          },
          success:function(res){
            if(res.success){
              var data = JSON.parse(res.data);
              if(data.avatar)
                $('#user-avatar').attr('src', '../uploads/images/'+data.avatar);
              $('#user-fullname').val(data.fullname);
              $('#user-email').val(data.email);
  
              if(data.gender){
                if(data.gender=="0"){
                  $('#user-gender').val('Male');
                }else{
                  $('#user-gender').val('Female');
                }
              }
  
              if(data.birth)
                $('#user-birth').val(data.birth);
              $('#user-status').prop('checked', data.status?true:false);
              $('#user-role').prop('checked', data.role?true:false);
  
              $('#user-login_status').val(data.login_status?"On":"Off");
              $('#user-date').val(new Date(data.date).toLocaleDateString('en-US', {month: 'short',day: 'numeric',year: 'numeric'}));
  
              $('#edit_id').val(id);
            }else{
              $('#edit_id').val('');
              modal.style.display = 'none';
            }
          }
        })
      }
      function editCancel(){
        var modal = document.getElementById('editModal');
        $('#edit_id').val('');
        modal.style.display = 'none';
      }
      function edit(){
        let edit_id = $('#edit_id').val();
        if(edit_id != ''){
          let isStatus = $('#user-status').prop('checked')?1:0;
          let isRole = $('#user-role').prop('checked')?1:0;
          $.ajax({
            url:'/admin/updateUser',
            type: "POST",
            data: {id:edit_id, status:isStatus, role:isRole},
            dataType: 'json',
            beforeSend: function(){
            },
            success:function(res){
              if(res.success){
                $('#edit_id').val('');
                var modal = document.getElementById('editModal');
                modal.style.display = 'none';
                reloadData();
              }
            }
          })
        }
      }
      
      $(document).ready(function() {
        const myInterval = setInterval(myTimer, 60*1000*10);
        function myTimer() {
          reloadData();
        }
        reloadData();
        //Modal Setting(delete modal)
        var modal = document.getElementById('myModal');
        var closeBtn = document.getElementsByClassName('close')[0];
        closeBtn.onclick = function() {
          modal.style.display = 'none';
        };
        //Modal Setting(edit modal)
        var editModal = document.getElementById('editModal');
        var editCloseBtn = document.getElementsByClassName('editClose')[0];
        editCloseBtn.onclick = function() {
          editModal.style.display = 'none';
        };
        window.onclick = function(event) {
          if (event.target == modal) {
            modal.style.display = 'none';
          }
          if (event.target == editModal) {
            editModal.style.display = 'none';
          }
        };
      });
    </script>
  </body>
  