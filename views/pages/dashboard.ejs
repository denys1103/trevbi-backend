<body>
    <!-- Sidenav -->
    <%- include('../partials/sidebar') -%>
    <!-- Main content -->
    <div class="main-content">
      <!-- Top navbar -->
      <%- include('../partials/navbar') -%>
      <!-- Header -->
      <%- include('../partials/header') -%>
      <!-- Page content -->
      <div class="container-fluid mt--7">
        <div class="row">
          <div class="col-xl-6 col-lg-6 col-md-6 mb-5 mb-xl-0">
            <div class="card card-stats">
              <div class="card-header card-header-warning card-header-icon">
                  <div class="card-icon">
                      <i class="fa fa-user text-white"></i>
                  </div>
                  <p class="card-category">Admin</p>
                  <h3 class="card-title">
                    <span id="admin_count"></span>
                  </h3>
              </div>
              <div class="card-footer">
              </div>
            </div>
          </div>
          <div class="col-xl-6 col-lg-6 col-md-6 mb-5 mb-xl-0">
            <div class="card card-stats">
              <div class="card-header card-header-success card-header-icon">
                  <div class="card-icon">
                      <i class="fa fa-users text-white"></i>
                  </div>
                  <p class="card-category">Total User</p>
                  <h3 class="card-title">
                    <span id="users_count"></span>
                  </h3>
              </div>
              <div class="card-footer">
              </div>
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col-sm-12">
              <div class="card">
                  <div class="card-header card-header-info">
                      <h4 class="card-title text-white">Installed information</h4>
                  </div>
                  <div class="card-body ">
                      <div class="fresh-datatables">
                          <table id="datatables" class="table table-striped table-no-bordered table-hover dataTable" cellspacing="0" width="100%" style="text-align:center" data-page-length="25">
                              <thead class=" text-primary">
                                  <tr>
                                    <th style="width:80px"> No </th>
                                    <th> Version </th>
                                    <th> Installed Users </th>
                                    <th></th>
                                  </tr>
                              </thead>
                              <tbody>
                                  <tr>
                                    <td></td>
                                    <td>Total</td>
                                    <td><span class="total_count"></span></td>
                                    <td></td>
                                  </tr>
                                  <tr>
                                    <td>1</td>
                                    <td>CleanLabel 1.0</td>
                                    <td><span class="total_count"></span></td>
                                    <td></td>
                                  </tr>
                                  <tr>
                                  </tr>
                                </tbody>
                          </table>
                      </div>
                  </div>
              </div>
          </div>
        </div>
        <!-- Footer -->
        <%- include('../partials/footer') -%>
      </div>
    </div>
    <!-- Include scripts -->
    <%- include('../partials/scripts') -%>
    <script>
      const reloadData = () => {
        $.ajax({
          url:'/admin/getDashboardData',
          type: "POST",
          data: {ok:true},
          dataType: 'json',
          beforeSend: function(){
          },
          success:function(res){
            if(res.success){
              let users = JSON.parse(res.users);
              let admins = users.filter(t => {
                if (t.role) {
                  return t;
                }
              });
              $('#admin_count').html(admins.length);
              $('#users_count').html(users.length-admins.length);
              $('.total_count').html(users.length);
            }
          }
        })
      }
  
      $(document).ready(function() {
        const myInterval = setInterval(myTimer, 60*1000*10);
        function myTimer() {
          reloadData();
        }
        reloadData();
      });
    </script>
  </body>
  
  