<body>
    <!-- Sidenav -->
    <%- include('../partials/sidebar') -%>
    <!-- Main content -->
    <div class="main-content">
      <!-- Top navbar -->
      <%- include('../partials/navbar') -%>
      <!-- Header -->
      <%- include('../partials/header') -%>
      <!-- Page content -->
      <div class="container-fluid mt--7">
        <!-- Table -->
        <div class="row">
          <div class="col">
            <div class="card shadow">
              <div class="card-header border-0">
                <h3 class="mb-0">Ingredients To Avoid</h3>
                <button class="btn bg-primary text-white" onclick="add()"><i class="fa fa-plus-circle"></i> Add</button>
              </div>
              <div class="table-responsive px-3">
                <table class="table align-items-center table-flush" id="datatable">
                  <thead class="thead-light">
                    <tr>
                      <th scope="col">No</th>
                      <th scope="col">Name</th>
                      <th scope="col">Description</th>
                      <th scope="col"></th>
                      <th scope="col"></th>
                      <!-- <th scope="col">Grade</th>
                      <th scope="col">Source</th> -->
                    </tr>
                  </thead>
                  <tbody id="mytbody">
                    
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div id="myModal" class="modal">
          <div class="del-modal-content">
            <span class="close">&times;</span>
            <h2>Remove Ingredients</h2>
            <p>Are you sure you want to delete this ingredients?</p>
            <div style="display: flex;justify-content: right;">
              <input type="hidden" id="del_id" value="">
              <button class="btn bg-info text-white" onclick="del()">Ok</button>&nbsp;&nbsp;&nbsp;<button class="btn bg-light" onclick="cancel()">Cancel</button>
            </div>
          </div>
        </div>
        <div id="editModal" class="modal">
          <div class="edit-modal-content">
            <span class="editClose">&times;</span>
            <h2>Register Ingredient</h2>
            <div class="card">
              <form id="myForm" role="form" action="/admin/registerIngredient" method="POST">
                <div class="card-body row">
                  <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                      <div class="row">
                        <div class="col-sm-12 row">
                          <label class="col-md-3 col-form-label">Ingredients Name</label>
                          <div class="col-md-5">
                              <div class="form-group bmd-form-group is-filled">
                                  <input class="form-control" id="ingredient_name" name="ingredient_name" type="text" placeholder="Ingredient Name" value="">
                              </div>
                          </div>
                        </div>
                        <div class="col-sm-12 row">
                          <label class="col-md-3 col-form-label">Description</label>
                          <div class="col-md-5">
                              <div class="form-group bmd-form-group is-filled">
                                  <input class="form-control" id="description" name="description" type="text" placeholder="Description" value="">
                              </div>
                          </div>
                        </div>
                        <div class="col-sm-12 row">
                          <label class="col-md-3 col-form-label">Source</label>
                          <div class="col-md-5">
                              <div class="form-group bmd-form-group is-filled">
                                  <input class="form-control" id="source" name="source" type="text" placeholder="source" value="">
                              </div>
                          </div>
                        </div>
                      </div>
                  </div>
                </div>
                <input type="hidden" id="edit_id" name="edit_id" value="">
              </form>
            </div>
            <div style="display: flex;justify-content: right;">
              <button class="btn bg-primary text-white" onclick="edit()">Save</button>&nbsp;&nbsp;&nbsp;<button class="btn bg-light" onclick="editCancel()">Cancel</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  
    <!-- Include scripts -->
    <%- include('../partials/scripts') -%>
    <script>
      var datatable = $('#datatable').DataTable({
        "pageLength": 10,
        "lengthMenu": [10, 25, 50, 100],
        "ordering": true,
        "columnDefs": [
          { "orderable": false, "targets": [] }
        ]
      });
      const reloadData = () => {
        $.ajax({
          url:'/admin/getIngredientsToAvoid',
          type: "POST",
          data: {ok:true},
          dataType: 'json',
          beforeSend: function(){
          },
          success:function(res){
            if(res.success){
              var data = JSON.parse(res.data);
              var html = '';
              $.each(data, function( index, item ) {
                html += '<tr>';
                html += '<td>'+(index+1)+'</td>';
                html += '<td>'+item.name+'</td>';
                html += '<td>'+item.description+'</td>';
                // html += '<td style="color:'+(item.grade==0?'red':'yellow')+'">'+(item.grade==0?'red':'yellow')+'</td>';
                html += '<td>'+(item.source?item.source:'')+'</td>';
                html += '<td>'+'<span onclick="editModal(\''+item._id+'\')" style="font-size:1rem;cursor:pointer"><i class="fa fa-pen fa-sm text-green"></i></span>'+'</td>';
                html += '<td>'+'<span onclick="showModal(\''+item._id+'\')" style="font-size:1.5rem;cursor:pointer"><i class="ni ni-fat-remove text-red"></i></span>'+'</td>';
                html += '</tr>';
              });
              datatable.clear();
              datatable.rows.add($(html)).draw();
            }
          }
        })
      }

      function showModal(id){
        var modal = document.getElementById('myModal');
        modal.style.display = 'block';
        $('#del_id').val(id);
      }
      function del(){
        let del_id = $('#del_id').val();
        if(del_id != ''){
          $.ajax({
            url:'/admin/delIngredient',
            type: "POST",
            data: {id:del_id},
            dataType: 'json',
            beforeSend: function(){
            },
            success:function(res){
              if(res.success){
                $('#del_id').val('');
                var modal = document.getElementById('myModal');
                modal.style.display = 'none';
                reloadData();
              }
            }
          })
        }
      }
      function cancel(){
        var modal = document.getElementById('myModal');
        $('#del_id').val('');
        modal.style.display = 'none';
      }
      function add(){
        var modal = document.getElementById('editModal');
        $('#ingredient_name').val('');
        $('#description').val('');
        $('#edit_id').val('');
        $('#source').val('');
        modal.style.display = 'block';
      }
      function editModal(id){
        var modal = document.getElementById('editModal');
        modal.style.display = 'block';
        //format modal
        $('#ingredient_name').val('');
        $('#description').val('');
        $('#edit_id').val('');
        $('#source').val('');
        $.ajax({
          url:'/admin/getEditIngredient',
          type: "POST",
          data: {id:id},
          dataType: 'json',
          beforeSend: function(){
          },
          success:function(res){
            if(res.success){
              var data = JSON.parse(res.data);
              $('#ingredient_name').val(data.name);
              $('#description').val(data.description);
              $('#source').val(data.source);
              $('#edit_id').val(id);
            }else{
              $('#edit_id').val('');
              modal.style.display = 'none';
            }
          }
        })
      }
      function editCancel(){
        var modal = document.getElementById('editModal');
        $('#edit_id').val('');
        modal.style.display = 'none';
      }
      function edit(){
        $('#myForm').submit();
      }
  
      $(document).ready(function() {
        reloadData();
        //Modal Setting(delete modal)
        var modal = document.getElementById('myModal');
        var closeBtn = document.getElementsByClassName('close')[0];
        closeBtn.onclick = function() {
          modal.style.display = 'none';
        };
        //Modal Setting(edit modal)
        var editModal = document.getElementById('editModal');
        var editCloseBtn = document.getElementsByClassName('editClose')[0];
        editCloseBtn.onclick = function() {
          editModal.style.display = 'none';
        };
        window.onclick = function(event) {
          if (event.target == modal) {
            modal.style.display = 'none';
          }
          if (event.target == editModal) {
            editModal.style.display = 'none';
          }
        };
      });
    </script>
  </body>
  